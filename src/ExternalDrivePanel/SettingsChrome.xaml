<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="HeaderChrome.xaml" /></ResourceDictionary.MergedDictionaries>
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,3" /><Setter Property="MinHeight" Value="28" /><Setter Property="Foreground" Value="#FF243447" /><Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#FFBFC5CC" /><Setter Property="BorderThickness" Value="1" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="SelectionBrush" Value="#FF607084" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ScrollViewer x:Name="PART_ContentHost" /></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FF607084" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Padding" Value="10,5" /><Setter Property="MinHeight" Value="28" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#FF3B4C60" />
        <Setter Property="BorderThickness" Value="0" /><Setter Property="BorderBrush" Value="#FFBFC5CC" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFE1E6ED" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#FFDDE6F3" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#FFD2DBE5" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#FF243447" /><Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF46586E" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#FF46586E" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#FF65788F" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="#FF3B4C60" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="8,5" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Ellipse Width="13" Height="13" Stroke="#FF8C99A7" Fill="White" HorizontalAlignment="Left" />
                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#FF243447" HorizontalAlignment="Left" Margin="3,0,0,0" Visibility="Collapsed" />
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#FFE1E6ED" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Background" Value="#FFDDE6F3" /></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible" /><Setter TargetName="Frame" Property="Background" Value="#FFE1E6ED" /><Setter Property="Foreground" Value="#FF243447" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#FF3B4C60" /><Setter Property="Padding" Value="8,5" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Border x:Name="Frame" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal"><Grid Width="14" Height="14" Margin="0,0,8,0">
                    <Border x:Name="Box" Background="White" BorderBrush="#FF8C99A7" BorderThickness="1" CornerRadius="2" />
                    <Path x:Name="Check" Data="M3,7 L6,10 11,4" Stroke="White" StrokeThickness="1.7" Visibility="Collapsed" />
                </Grid><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" /></StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#FFE1E6ED" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Background" Value="#FFDDE6F3" /></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#FF243447" /><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsSection" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#FF243447" /></Style>
    <Style x:Key="SettingsHint" TargetType="TextBlock"><Setter Property="Foreground" Value="#FF68717C" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="SettingsSeparator" TargetType="Border"><Setter Property="Height" Value="1" /><Setter Property="Background" Value="#FFD0D5DC" /><Setter Property="Margin" Value="0,8" /></Style>
</ResourceDictionary>
