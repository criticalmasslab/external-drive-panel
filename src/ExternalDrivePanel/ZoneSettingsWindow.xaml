<Window x:Class="ExternalDrivePanel.ZoneSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ExternalDrivePanel"
        Title="화면 영역 설정" Width="390" Height="520" WindowStyle="None" WindowStartupLocation="Manual"
        ResizeMode="CanResize" Background="#FFF7F7F7" Foreground="#FF243447" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary Source="SettingsChrome.xaml" /></Window.Resources>
    <Border x:Name="SettingsFrame" BorderBrush="#FF607084" BorderThickness="1"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border x:Name="SettingsHeader" Height="{DynamicResource SettingsHeaderHeight}" Background="#FF243447" Padding="{DynamicResource ChromeHeaderPadding}" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:SymbolIcon Kind="Settings" Foreground="White" Margin="0,0,8,0" /><TextBlock Text="화면 영역 설정" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                <Button x:Name="HeaderCloseButton" Grid.Column="1" Style="{StaticResource ChromeButton}" ToolTip="닫기 — 변경사항 유지" AutomationProperties.Name="설정 닫기" Click="CloseButton_OnClick"><local:SymbolIcon Kind="Close" /></Button>
            </Grid>
        </Border>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
            <StackPanel>
                <TextBlock Text="시작 옵션" Style="{StaticResource SettingsSection}" />
                <CheckBox x:Name="StartupCheck" Content="Windows 시작 시 자동 실행" Margin="0,6,0,0" Checked="Startup_OnChanged" Unchecked="Startup_OnChanged" />
                <TextBlock x:Name="StartupMessage" Style="{StaticResource SettingsHint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <Border Style="{StaticResource SettingsSeparator}" />
                <TextBlock Text="모니터" Style="{StaticResource SettingsSection}" />
                <StackPanel x:Name="MonitorOptions" Margin="0,5,0,0" />
                <Border Style="{StaticResource SettingsSeparator}" />
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="화면 분할" Style="{StaticResource SettingsSection}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="가로" VerticalAlignment="Center" /><TextBox x:Name="GridColsText" AutomationProperties.Name="가로 분할 수" Width="48" Margin="7,0,12,0" TextChanged="Form_OnChanged" />
                        <TextBlock Text="세로" VerticalAlignment="Center" /><TextBox x:Name="GridRowsText" AutomationProperties.Name="세로 분할 수" Width="48" Margin="7,0,0,0" TextChanged="Form_OnChanged" />
                    </StackPanel>
                </Grid>
                <Border Background="White" BorderBrush="#FFBFC5CC" BorderThickness="1" CornerRadius="3" Padding="4"><UniformGrid x:Name="GridPreview" Height="80" /></Border>
                <TextBlock x:Name="SelectionHint" Style="{StaticResource SettingsHint}" Margin="0,4,0,8" />
                <TextBlock Text="외장하드 패널 배치" Style="{StaticResource SettingsSection}" Margin="0,0,0,5" />
                <UniformGrid Columns="2">
                    <RadioButton x:Name="VerticalSplitRadio" Content="위아래로 나열" GroupName="Split" Margin="0,0,4,0" Checked="Option_OnChanged" />
                    <RadioButton x:Name="HorizontalSplitRadio" Content="좌우로 나열" GroupName="Split" Checked="Option_OnChanged" />
                </UniformGrid>
                <Border Style="{StaticResource SettingsSeparator}" />
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="바깥 여백" Style="{StaticResource SettingsSection}" VerticalAlignment="Center" />
                    <CheckBox x:Name="UniformMarginCheck" Grid.Column="1" Content="사방 동일" Checked="UniformMargin_OnChanged" Unchecked="UniformMargin_OnChanged" />
                </Grid>
                <StackPanel x:Name="UniformMarginPanel" Orientation="Horizontal">
                    <TextBlock Text="전체" Width="45" VerticalAlignment="Center" /><TextBox x:Name="MarginAllText" AutomationProperties.Name="전체 여백" Width="70" TextChanged="Form_OnChanged" /><TextBlock Text="px" Style="{StaticResource SettingsHint}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <Grid x:Name="IndividualMarginPanel">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="70" /><ColumnDefinition Width="32" /><ColumnDefinition Width="45" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="위" VerticalAlignment="Center" /><TextBox x:Name="MarginTopText" Grid.Column="1" AutomationProperties.Name="위 여백" Margin="0,0,0,6" TextChanged="Form_OnChanged" />
                    <TextBlock Text="아래" Grid.Column="3" VerticalAlignment="Center" /><TextBox x:Name="MarginBottomText" Grid.Column="4" AutomationProperties.Name="아래 여백" Margin="0,0,0,6" TextChanged="Form_OnChanged" />
                    <TextBlock Text="왼쪽" Grid.Row="1" VerticalAlignment="Center" /><TextBox x:Name="MarginLeftText" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="왼쪽 여백" TextChanged="Form_OnChanged" />
                    <TextBlock Text="오른쪽" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" /><TextBox x:Name="MarginRightText" Grid.Row="1" Grid.Column="4" AutomationProperties.Name="오른쪽 여백" TextChanged="Form_OnChanged" />
                </Grid>
                <TextBlock Text="선택 영역 가장자리와 패널 사이의 간격입니다. (px)" Style="{StaticResource SettingsHint}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#FFF4F5F7" BorderBrush="#FFD0D5DC" BorderThickness="0,1,0,0" Padding="12,8"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="변경 즉시 반영" Foreground="#FF3B4C60" /><TextBlock Text="취소하면 이전 설정으로 돌아갑니다." FontSize="11" Style="{StaticResource SettingsHint}" Margin="0,3,0,0" />
                <TextBlock x:Name="ValidationMessage" Foreground="#FFB64E3B" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CancelButton" Content="취소" MinWidth="64" Margin="0,0,6,0" IsCancel="True" Click="CancelButton_OnClick" />
                <Button x:Name="CloseButton" Content="닫기" Style="{StaticResource SettingsPrimaryButton}" MinWidth="64" IsDefault="True" Click="CloseButton_OnClick" />
            </StackPanel>
        </Grid></Border>
    </Grid></Border>
</Window>
