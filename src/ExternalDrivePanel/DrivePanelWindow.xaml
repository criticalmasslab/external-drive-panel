<Window x:Class="ExternalDrivePanel.DrivePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="External Drive Panel"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        Background="#FFF7F7F7">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="7,2" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="#FFD0D0D0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="14,9" Background="#FF243447">
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="17"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </Border>

            <ToolBar Grid.Row="1" Padding="3" Background="#FFF4F5F7" ToolBarTray.IsLocked="True">
                <Button x:Name="BackButton" Style="{StaticResource ToolbarButton}" Content="←" ToolTip="뒤로" Click="BackButton_OnClick" />
                <Button x:Name="ForwardButton" Style="{StaticResource ToolbarButton}" Content="→" ToolTip="앞으로" Click="ForwardButton_OnClick" />
                <Button x:Name="UpButton" Style="{StaticResource ToolbarButton}" Content="↑" ToolTip="위로" Click="UpButton_OnClick" />
                <Button Style="{StaticResource ToolbarButton}" Content="🏠" ToolTip="즐겨찾기 홈" Click="HomeButton_OnClick" />
                <Separator />
                <Button x:Name="IconViewButton" Style="{StaticResource ToolbarButton}" Content="▦ 아이콘" ToolTip="아이콘 보기" Click="IconViewButton_OnClick" />
                <Button x:Name="DetailsViewButton" Style="{StaticResource ToolbarButton}" Content="☷ 상세" ToolTip="상세 보기" Click="DetailsViewButton_OnClick" />
            </ToolBar>

            <Border Grid.Row="2" Margin="6,3,6,5" Padding="7,3" BorderBrush="#FFBFC5CC"
                    BorderThickness="1" CornerRadius="3" Background="White">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3">
                <ListBox x:Name="FavoriteItemsList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="FavoriteItemsList_OnSelectionChanged"
                         MouseDoubleClick="FavoriteItemsList_OnMouseDoubleClick"
                         PreviewMouseRightButtonDown="Items_OnPreviewMouseRightButtonDown"
                         ContextMenuOpening="FavoriteItemsList_OnContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="즐겨찾기에서 제거" Click="RemoveFavorite_OnClick" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="FavoriteTile" Width="105" Margin="5" Padding="7"
                                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="5"
                                    ToolTip="{Binding Path}">
                                <StackPanel>
                                    <TextBlock FontSize="25" HorizontalAlignment="Center" Text="{Binding Icon}" />
                                    <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="38" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                    <Setter TargetName="FavoriteTile" Property="Background" Value="#FFE4F0FF" />
                                    <Setter TargetName="FavoriteTile" Property="BorderBrush" Value="#FF4B82C3" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox x:Name="IconItemsList" Visibility="Collapsed" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="Items_OnMouseDoubleClick"
                         PreviewMouseRightButtonDown="Items_OnPreviewMouseRightButtonDown">
                    <ListBox.ContextMenu>
                        <ContextMenu><MenuItem Header="즐겨찾기에 추가" Click="AddFavorite_OnClick" /></ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="105" Margin="5" ToolTip="{Binding FullPath}">
                                <TextBlock FontSize="24" HorizontalAlignment="Center" Text="{Binding Icon}" />
                                <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="38" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DataGrid x:Name="DetailsGrid" Visibility="Collapsed" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                          MouseDoubleClick="Items_OnMouseDoubleClick" Sorting="DetailsGrid_OnSorting"
                          PreviewMouseRightButtonDown="Items_OnPreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu><MenuItem Header="즐겨찾기에 추가" Click="AddFavorite_OnClick" /></ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="이름" Binding="{Binding DisplayName}" SortMemberPath="Name" Width="2*" />
                        <DataGridTextColumn Header="수정한 날짜" Binding="{Binding ModifiedDate, StringFormat=yyyy-MM-dd HH:mm}" SortMemberPath="ModifiedDate" Width="*" />
                        <DataGridTextColumn Header="크기" Binding="{Binding SizeDisplay}" SortMemberPath="Size" Width="Auto" />
                        <DataGridTextColumn Header="유형" Binding="{Binding Type}" SortMemberPath="Type" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Border>
</Window>