<Window x:Class="ExternalDrivePanel.DrivePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExternalDrivePanel"
        Title="External Drive Panel"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="#FFF7F7F7">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HeaderChrome.xaml" />
                <ResourceDictionary Source="PanelScrollBars.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FavoriteBadge" TargetType="local:SymbolIcon">
                <Setter Property="Kind" Value="StarFill" /><Setter Property="Foreground" Value="#FFE3A51B" />
                <Setter Property="Width" Value="{DynamicResource FavoriteBadgeSize}" /><Setter Property="Height" Value="{DynamicResource FavoriteBadgeSize}" />
                <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="IconTile" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Margin" Value="2" /><Setter Property="Padding" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>
            <Style x:Key="ItemIcon" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource IconGlyphSize}" />
                <Setter Property="Height" Value="{DynamicResource IconGlyphHeight}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ItemCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" /><Setter Property="Height" Value="32" />
                <Setter Property="LineHeight" Value="16" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="TextAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="Width" Value="{DynamicResource ChromeButtonWidth}" />
                <Setter Property="Height" Value="{DynamicResource ChromeButtonHeight}" />
                <Setter Property="Margin" Value="{DynamicResource ChromeButtonMargin}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FF3B4C60" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFE1E6ED" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#FFD2DBE5" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#FFDDE6F3" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#FFD0D0D0" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="PanelHeader" Height="{DynamicResource PanelChromeHeight}" Padding="{DynamicResource ChromeHeaderPadding}" Background="#FF243447">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DriveTitleButton" Style="{StaticResource ChromeButton}" Width="Auto" Height="Auto" Margin="0,0,4,0" Padding="2,0"
                            HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" Click="DriveTitleButton_OnClick"
                            ToolTip="{Binding Text, ElementName=TitleText}">
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="13" TextAlignment="Left" VerticalAlignment="Center"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <StackPanel x:Name="HeaderNavigation" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BackButton" Style="{StaticResource ChromeButton}" ToolTip="{local:Translate L2DF06869205B07FE}" Click="BackButton_OnClick"><local:SymbolIcon Kind="Back" /></Button>
                            <Button x:Name="ForwardButton" Style="{StaticResource ChromeButton}" ToolTip="{local:Translate LCB4897C6B6949E02}" Click="ForwardButton_OnClick"><local:SymbolIcon Kind="Forward" /></Button>
                            <Button x:Name="UpButton" Style="{StaticResource ChromeButton}" ToolTip="{local:Translate L3FD4BDBE77C71CEA}" Click="UpButton_OnClick"><local:SymbolIcon Kind="Up" /></Button>
                            <Button x:Name="HomeButton" Style="{StaticResource ChromeButton}" ToolTip="{local:Translate LF8E7D07DC57D063A}" Click="HomeButton_OnClick"><local:SymbolIcon x:Name="HomeIcon" Kind="Home" /></Button>
                            <Button x:Name="AddFavoritesButton" Style="{StaticResource ChromeButton}" ToolTip="{local:Translate L7EEF3E5D202CA3FE}" Click="AddFavoritesButton_OnClick"><local:SymbolIcon Kind="Favorite" /></Button>
                            <Button Style="{StaticResource ChromeButton}" ToolTip="{local:Translate L15C88A10A595B2D4}" Click="EjectButton_OnClick"><local:SymbolIcon Kind="Eject" /></Button>
                            <Border Width="1" Margin="2,4" Background="#FF607084" />
                            <Button x:Name="ViewModeButton" Style="{StaticResource ChromeButton}" AutomationProperties.Name="{local:Translate L6E63E8AA759C28A5}" Click="ViewModeButton_OnClick"><local:SymbolIcon x:Name="ViewModeIcon" Kind="Grid" /></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <local:VolumeCapacityBar x:Name="CapacityBar" Grid.Row="1" Height="{DynamicResource CapacityBarHeight}" />

            <Border x:Name="FileToolbar" Grid.Row="2" Height="{DynamicResource PanelChromeHeight}" Padding="3,0" Background="#FFF4F5F7">
            <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="NewItemButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="{local:Translate L61CBFB012ECB0885}" ToolTip="{local:Translate L4EC2CC8D57793197}"><local:SymbolIcon Kind="NewFolder" /></Button>
                <Border Width="1" Margin="3,4" Background="#FFD0D5DC" />
                <Button x:Name="CutButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="{local:Translate L41052DAEF743AA5F}" ToolTip="{local:Translate L9C6F6B3239F5A5FC}"><local:SymbolIcon Kind="Cut" /></Button>
                <Button x:Name="CopyButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="{local:Translate L37B3D3B11B2637F6}" ToolTip="{local:Translate L1CA09AC44002D77B}"><local:SymbolIcon Kind="Copy" /></Button>
                <Button x:Name="PasteButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="{local:Translate L8E45BFBB76052ECD}" ToolTip="{local:Translate LF7B2136E8C971CBE}"><local:SymbolIcon Kind="Paste" /></Button>
                <Button x:Name="RenameButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="{local:Translate L39E046478AE8A99E}" ToolTip="{local:Translate LF7CFE3A06E3327BF}"><local:SymbolIcon Kind="Rename" /></Button>
                <Button x:Name="ShareButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="{local:Translate LD62648E19143C34D}" ToolTip="{local:Translate L454AEF72B4DAF592}"><local:SymbolIcon Kind="Share" /></Button>
                <Button x:Name="DeleteButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="{local:Translate L6139B6C3ED73CD4A}" ToolTip="{local:Translate L82BDD3D495C6E022}"><local:SymbolIcon Kind="Delete" /></Button>
            </StackPanel>
            <Border x:Name="SearchBoxBorder" Grid.Column="1" Background="White" BorderBrush="#FFBFC5CC" BorderThickness="1" CornerRadius="3"
                    Height="{DynamicResource ChromeButtonHeight}" Margin="4,0,3,0" Padding="4,0" ClipToBounds="True">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox" BorderThickness="0" Background="Transparent" Padding="0" MinWidth="0" FontSize="12"
                             VerticalContentAlignment="Center" AutomationProperties.Name="{local:Translate L31843898C0EB23AC}" ToolTip="{local:Translate LA0A49C30F5CF26B4}"
                             PreviewKeyDown="Search_OnKeyDown" TextChanged="SearchText_OnChanged" />
                    <TextBlock Text="{local:Translate L1FC57009F7522E9E}" Foreground="#FF89919A" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource ToolbarButton}" Width="{DynamicResource SearchActionWidth}" Height="{DynamicResource SearchActionHeight}" Margin="0" Padding="0" ToolTip="{local:Translate L62639EC31CA4B494}" AutomationProperties.Name="{local:Translate L4B8D541EBE6D9003}" Click="Search_OnClick"><local:SymbolIcon Kind="Search" Width="{DynamicResource SearchIconSize}" Height="{DynamicResource SearchIconSize}" /></Button>
                    <Button x:Name="SearchClearButton" Grid.Column="2" Style="{StaticResource ToolbarButton}" Width="{DynamicResource SearchClearWidth}" Height="{DynamicResource SearchActionHeight}" Margin="0" Padding="0" Visibility="Collapsed" ToolTip="{local:Translate L90A3D343FAEA48F7}" AutomationProperties.Name="{local:Translate LD5868003C32ABBD6}" Click="SearchClear_OnClick"><local:SymbolIcon Kind="Close" Width="{DynamicResource SearchCloseIconSize}" Height="{DynamicResource SearchCloseIconSize}" /></Button>
                </Grid>
            </Border>
            </Grid>
            </Border>

            <Border x:Name="AddressBox" Grid.Row="3" Height="{DynamicResource ChromeButtonHeight}" Margin="6,3,6,5" Padding="7,0" BorderBrush="#FFBFC5CC"
                    BorderThickness="1" CornerRadius="3" Background="White">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Center"
                              PreviewMouseWheel="AddressScroll_OnMouseWheel">
                    <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                </ScrollViewer>
            </Border>

            <AdornerDecorator Grid.Row="4">
            <Grid x:Name="ContentArea" Background="Transparent" PreviewMouseDown="ContentArea_OnPreviewMouseDown">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border x:Name="SearchStatus" Background="#FFE8EDF3" Padding="6,3" Visibility="Collapsed" SizeChanged="SearchStatus_OnSizeChanged">
                    <DockPanel><Button x:Name="SearchStopButton" DockPanel.Dock="Right" Content="{local:Translate L92CDEF3C5BC09F84}" Click="SearchStop_OnClick" Padding="4,0" Margin="4,0,0,0" />
                        <TextBlock x:Name="SearchStatusText" FontSize="11" Foreground="#FF526174" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ListBox x:Name="FavoriteItemsList" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionMode="Extended" ScrollViewer.CanContentScroll="False"
                         FocusVisualStyle="{x:Null}"
                         ItemContainerStyle="{StaticResource IconTile}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="FavoriteItemsList_OnSelectionChanged"
                         MouseDoubleClick="FavoriteItemsList_OnMouseDoubleClick"
                         >
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemWidth="{DynamicResource IconTileWidth}" ItemHeight="{DynamicResource IconTileHeight}" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding Path}">
                                <local:FilePreview FilePath="{Binding Path}" FallbackGlyph="{Binding Icon}" PreviewEnabled="{DynamicResource ShowFilePreviews}" GlyphSize="{DynamicResource IconGlyphSize}" Width="{DynamicResource IconGlyphHeight}" Height="{DynamicResource IconGlyphHeight}" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource ItemCaption}" Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyFavoritesMessage" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Panel.ZIndex="1"
                           Margin="24" TextAlignment="Center" TextWrapping="Wrap" Foreground="#FF68717C"
                           Text="{local:Translate L079DF040CB1BD8A9}" />

                <ListBox x:Name="IconItemsList" Grid.Row="1" Visibility="Collapsed" BorderThickness="0" Background="Transparent" SelectionMode="Extended" ScrollViewer.CanContentScroll="False"
                         FocusVisualStyle="{x:Null}"
                         ItemContainerStyle="{StaticResource IconTile}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="Items_OnMouseDoubleClick"
                         SelectionChanged="Items_OnSelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemWidth="{DynamicResource IconTileWidth}" ItemHeight="{DynamicResource IconTileHeight}" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding FullPath}">
                                <Grid Width="{DynamicResource IconGlyphHeight}" Height="{DynamicResource IconGlyphHeight}" HorizontalAlignment="Center">
                                    <local:FilePreview FilePath="{Binding FullPath}" FallbackGlyph="{Binding Icon}" PreviewEnabled="{DynamicResource ShowFilePreviews}" GlyphSize="{DynamicResource IconGlyphSize}" />
                                    <local:SymbolIcon Style="{StaticResource FavoriteBadge}" />
                                </Grid>
                                <TextBlock Style="{StaticResource ItemCaption}" Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DataGrid x:Name="DetailsGrid" Grid.Row="1" Visibility="Collapsed" AutoGenerateColumns="False"
                          RowHeight="{x:Static local:PanelListMetrics.RowHeight}" ColumnHeaderHeight="{x:Static local:PanelListMetrics.HeaderHeight}"
                          FocusVisualStyle="{x:Null}"
                          SelectionMode="Extended" SelectionUnit="FullRow" VirtualizingPanel.ScrollUnit="Pixel"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" GridLinesVisibility="None" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#FFF1F4F8" AlternationCount="2"
                          MouseDoubleClick="Items_OnMouseDoubleClick" Sorting="DetailsGrid_OnSorting"
                          SelectionChanged="Items_OnSelectionChanged">
                    <DataGrid.Resources>
                        <Style x:Key="CenteredDetailsText" TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="4,0" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                        <Style x:Key="RightDetailsText" TargetType="TextBlock" BasedOn="{StaticResource CenteredDetailsText}">
                            <Setter Property="TextAlignment" Value="Right" />
                        </Style>
                        <Style x:Key="DetailsHeader" TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                        <Style x:Key="CenteredDetailsHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DetailsHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="RightDetailsHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DetailsHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{local:Translate L253D1510CAF53620}" SortMemberPath="Name" Width="2*" HeaderStyle="{StaticResource DetailsHeader}">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Grid ToolTip="{Binding FullPath}"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid Width="24" Height="24"><local:FilePreview FilePath="{Binding FullPath}" FallbackGlyph="{Binding Icon}" PreviewEnabled="{DynamicResource ShowFilePreviews}" GlyphSize="16" />
                                        <local:SymbolIcon Style="{StaticResource FavoriteBadge}" Width="9" Height="9" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{local:Translate L90665568632CBFB8}" Binding="{Binding ModifiedDate, StringFormat=yyyy-MM-dd HH:mm}" SortMemberPath="ModifiedDate" Width="*"
                                            ElementStyle="{StaticResource CenteredDetailsText}" HeaderStyle="{StaticResource CenteredDetailsHeader}" />
                        <DataGridTextColumn Header="{local:Translate L82232621B82D72BE}" Binding="{Binding SizeDisplay}" SortMemberPath="Size" Width="Auto"
                                            ElementStyle="{StaticResource CenteredDetailsText}" HeaderStyle="{StaticResource CenteredDetailsHeader}" />
                        <DataGridTextColumn Header="{local:Translate L5CF2792B3FAB3578}" Binding="{Binding Type}" SortMemberPath="Type" Width="*"
                                            ElementStyle="{StaticResource RightDetailsText}" HeaderStyle="{StaticResource RightDetailsHeader}" />
                        <DataGridTextColumn x:Name="SearchLocationColumn" Header="{local:Translate L6C0B9DD710AB0FDE}" Binding="{Binding DirectoryPath}" Width="2*" CanUserSort="False" Visibility="Collapsed" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            </AdornerDecorator>
        </Grid>
    </Border>
</Window>
