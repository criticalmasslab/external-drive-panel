<Window x:Class="ExternalDrivePanel.DrivePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="External Drive Panel"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        Background="#FFF7F7F7">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ViewModeButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="Padding" Value="7,2" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#FFD0D0D0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="14,9" Background="#FF243447">
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="17"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </Border>

            <ToolBar Grid.Row="1" Padding="3" Background="#FFF4F5F7" ToolBarTray.IsLocked="True">
                <Button x:Name="BackButton" Style="{StaticResource ToolbarButton}" Content="←" ToolTip="뒤로" Click="BackButton_OnClick" />
                <Button x:Name="ForwardButton" Style="{StaticResource ToolbarButton}" Content="→" ToolTip="앞으로" Click="ForwardButton_OnClick" />
                <Button x:Name="UpButton" Style="{StaticResource ToolbarButton}" Content="↑" ToolTip="위로" Click="UpButton_OnClick" />
                <Button Style="{StaticResource ToolbarButton}" Content="🏠" ToolTip="즐겨찾기 홈" Click="HomeButton_OnClick" />
                <Button x:Name="DriveRootButton" Style="{StaticResource ToolbarButton}" ToolTip="드라이브 루트" Click="DriveRootButton_OnClick" />
                <Button Style="{StaticResource ToolbarButton}" Content="⏏" ToolTip="안전하게 꺼내기" Click="EjectButton_OnClick" />
                <Separator />
                <ToggleButton x:Name="IconViewButton" Style="{StaticResource ViewModeButtonStyle}" ToolBar.OverflowMode="Never" Content="⊞" ToolTip="이 패널 아이콘 보기" Click="IconViewButton_OnClick" />
                <ToggleButton x:Name="DetailsViewButton" Style="{StaticResource ViewModeButtonStyle}" ToolBar.OverflowMode="Never" Content="☰" ToolTip="이 패널 상세 보기" Click="DetailsViewButton_OnClick" />
            </ToolBar>

            <Border Grid.Row="2" Margin="6,3,6,5" Padding="7,3" BorderBrush="#FFBFC5CC"
                    BorderThickness="1" CornerRadius="3" Background="White">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </Border>

            <AdornerDecorator Grid.Row="3">
            <Grid x:Name="ContentArea" Background="Transparent" PreviewMouseDown="ContentArea_OnPreviewMouseDown">
                <ListBox x:Name="FavoriteItemsList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="FavoriteItemsList_OnSelectionChanged"
                         MouseDoubleClick="FavoriteItemsList_OnMouseDoubleClick"
                         >
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="105" Margin="5" Padding="7"
                                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="5"
                                    ToolTip="{Binding Path}">
                                <StackPanel>
                                    <TextBlock FontSize="{DynamicResource IconGlyphSize}" HorizontalAlignment="Center" Text="{Binding Icon}" />
                                    <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="38" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyFavoritesMessage" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Panel.ZIndex="1"
                           Margin="24" TextAlignment="Center" TextWrapping="Wrap" Foreground="#FF68717C"
                           Text="즐겨찾기가 없습니다. 폴더나 파일을 우클릭해서 추가해보세요." />

                <ListBox x:Name="IconItemsList" Visibility="Collapsed" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="Items_OnMouseDoubleClick"
                         SelectionChanged="Items_OnSelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="105" Margin="5" ToolTip="{Binding FullPath}">
                                <TextBlock FontSize="{DynamicResource IconGlyphSize}" HorizontalAlignment="Center" Text="{Binding Icon}" />
                                <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="38" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DataGrid x:Name="DetailsGrid" Visibility="Collapsed" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                          MouseDoubleClick="Items_OnMouseDoubleClick" Sorting="DetailsGrid_OnSorting"
                          SelectionChanged="Items_OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="이름" Binding="{Binding DisplayName}" SortMemberPath="Name" Width="2*" />
                        <DataGridTextColumn Header="수정한 날짜" Binding="{Binding ModifiedDate, StringFormat=yyyy-MM-dd HH:mm}" SortMemberPath="ModifiedDate" Width="*" />
                        <DataGridTextColumn Header="크기" Binding="{Binding SizeDisplay}" SortMemberPath="Size" Width="Auto" />
                        <DataGridTextColumn Header="유형" Binding="{Binding Type}" SortMemberPath="Type" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            </AdornerDecorator>
        </Grid>
    </Border>
</Window>
