<Window x:Class="ExternalDrivePanel.DrivePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="External Drive Panel"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        Background="#FFF7F7F7">
    <Border BorderBrush="#FFD0D0D0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="16,12" Background="#FF243447">
                <TextBlock x:Name="TitleText"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <ListBox x:Name="ItemsList"
                     Grid.Row="1"
                     BorderThickness="0"
                     Background="Transparent"
                     FontSize="14"
                     MouseDoubleClick="ItemsList_OnMouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Padding="8,5" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
